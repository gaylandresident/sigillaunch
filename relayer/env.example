## Robinhood Chain (Alchemy dedicated endpoint)
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BURN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0

## Zcash lightwalletd (default: ECC-hosted testnet, switch to mainnet in prod)
LIGHTWALLETD_HOST=lightwalletd.testnet.electriccoin.co
LIGHTWALLETD_PORT=9067
ZCASH_NETWORK=testnet     # testnet | mainnet

## Zcash wallet seed (BIP-39). Keep MINIMAL ZEC in this hot wallet.
## Generate: `bip39.generateMnemonic(256)`
ZCASH_SEED_MNEMONIC="test test test test test test test test test test test junk"
ZCASH_ACCOUNT_INDEX=0

## Postgres (shared with backend indexer)
DATABASE_URL=postgres://sigil:sigil@localhost:5432/sigil

## Logging
LOG_LEVEL=info
